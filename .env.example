# AI model (any OpenAI-compatible API; Groq has a free tier)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=llama-3.1-8b-instant

# Supabase (Project Settings -> API). The service role key stays on the server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio WhatsApp sandbox (Console -> Account info)
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Password for /dashboard (username: admin)
DASHBOARD_PASSWORD=choose-a-long-password

# Used to hash phone numbers before they are stored
CONTACT_SALT=any-long-random-text
